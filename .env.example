# FRONTEND
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SERVER
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
JARVIS_OWNER_ID="your-uuid"

# RUNTIME ROLE — which local-only resources this process is allowed to touch.
#   web-control-plane = Vercel-deployed Next.js app. Must NEVER reach Ollama on
#                        127.0.0.1, spawn child_process, touch D:\, or launch
#                        Desktop Commander/Docker directly — those go through
#                        the daemon task/capability system instead.
#   local-worker       = the daemon (src/daemon) on the Windows PC. Full local
#                        access.
#   local-full-dev     = Next.js app run locally (`npm run dev`) for
#                        development — behaves like today, full local access.
# This is a routing/UX flag, not the security boundary by itself — real
# enforcement is the daemon token + owner-only Supabase auth already in place
# (see docs/jarvis/remote-architecture.md).
JARVIS_RUNTIME_ROLE="local-full-dev"

# DAEMON
JARVIS_DAEMON_INSTALLATION_ID=""
JARVIS_DAEMON_DEVICE_NAME="JARVIS-PC"
JARVIS_DAEMON_GATEWAY_URL="http://localhost:3000"
JARVIS_DAEMON_TOKEN="your-daemon-secret"
JARVIS_WORKSPACES_ROOT="D:\JARVIS_WORKSPACES"
JARVIS_ARTIFACTS_ROOT="D:\JARVIS_ARTIFACTS"
JARVIS_LOGS_ROOT="D:\JARVIS_LOGS"
JARVIS_TEMP_ROOT="D:\JARVIS_TEMP"
JARVIS_DAEMON_POLL_INTERVAL_MS="2000"
JARVIS_DAEMON_HEARTBEAT_INTERVAL_MS="30000"
# PROVIDERS
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""
OPENROUTER_MODEL=""
# OpenCode Go — server/local-only. See src/lib/ai-provider/opencode-go/.
# Never move these under NEXT_PUBLIC_*.
OPENCODE_GO_API_KEY=""
OPENCODE_GO_BASE_URL=""
OPENCODE_GO_MODELS_URL=""
OPENCODE_GO_CHAT_URL=""
OPENCODE_GO_MESSAGES_URL=""
OPENCODE_GO_RESPONSES_URL=""
CAMOFOX_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MUSIC_CHANNEL=""

# TELEGRAM MUSIC (MTProto userbot — для аудиоархива канала)
# Получить api_id/api_hash: https://my.telegram.org → API development tools
# Сессию создать один раз: node scripts/tg-music-login.mjs
TG_API_ID=""
TG_API_HASH=""
TG_SESSION=""
TELEGRAM_ALLOWED_USER_ID=""

# LEGACY / OPTIONAL
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
JARWISYAN_AUTH_ENABLED=""
JARWISYAN_ADMIN_PASSWORD=""
GITHUB_TOKEN=""
