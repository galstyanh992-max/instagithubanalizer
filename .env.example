# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth — MUST be "true" in production. In prod, an unset value defaults to ENABLED (fail closed).
# In local dev, auth is OFF unless this is explicitly "true".
JARWISYAN_AUTH_ENABLED="true"
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# AI Providers
OPENROUTER_API_KEY="replace-with-your-openrouter-key"
GLM_API_KEY="replace-with-your-glm-key"

# ─── JARVIS Model Hierarchy ──────────────────────────────────
# GPT-5.5 Thinking — Orchestrator / CEO brain
OPENAI_THINKING_API_KEY=""
OPENAI_THINKING_BASE_URL="https://api.openai.com/v1"
OPENAI_THINKING_MODEL="gpt-5.5-thinking"

# Kimi K2.7 Code — Second developer / MCP / Tool Use
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
KIMI_MODEL="kimi-k2.7-code"

# Legal Armenia AI — isolated legal/RAG/PDF model
LEGAL_AI_API_KEY=""
LEGAL_AI_BASE_URL="https://api.legal-armenia.ai/v1"
LEGAL_AI_MODEL="legal-armenia-pro"

